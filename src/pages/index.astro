---
// 3D Earth Visualization - Main Page
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Earth</title>
  </head>

  <body>
    <div id="loading-overlay" class="loading-overlay">
      <div class="loading-content">
        <div class="loading-spinner"></div>
        <p class="loading-text">Loading Earth textures...</p>
        <div class="loading-progress-container">
          <div id="loading-progress" class="loading-progress"></div>
        </div>
        <p id="loading-status" class="loading-status">0%</p>
      </div>
    </div>

    <div id="error-overlay" class="error-overlay" style="display: none;">
      <div class="error-content">
        <p class="error-icon">⚠</p>
        <p id="error-message" class="error-message">Failed to load textures</p>
        <button id="retry-button" class="retry-button">Retry</button>
      </div>
    </div>

    <div class="controls">
      <div class="slider-container">
        <div class="slider-container-title">
          <label for="datePicker">Date</label>
          <input
            type="date"
            id="datePicker"
            class="date-picker"
          />
        </div>
        <div class="preset-buttons">
          <button class="preset-btn" id="presetSpringEquinox" title="Spring Equinox: Day and night are nearly equal length worldwide">Spring Eq</button>
          <button class="preset-btn" id="presetSummerSolstice" title="Summer Solstice: Longest day in the Northern Hemisphere">Summer Sol</button>
          <button class="preset-btn" id="presetAutumnEquinox" title="Autumn Equinox: Day and night are nearly equal length worldwide">Autumn Eq</button>
          <button class="preset-btn" id="presetWinterSolstice" title="Winter Solstice: Shortest day in the Northern Hemisphere">Winter Sol</button>
        </div>
      </div>

      <div class="slider-container">
        <div class="slider-container-title">
          <label for="timeSlider">Time control</label>
          <span class="time-display">
            <span id="currentTime">--:-- <span class="time-display-utc">(--:-- UTC)</span></span>
          </span>
        </div>
        <input
          type="range"
          id="timeSlider"
          class="slider"
          min="0"
          max="1440"
          value="720"
          step="15"
        />
        <div class="playback-controls">
          <button id="playPauseBtn" class="playback-btn" title="Play/Pause (Space)">
            <span id="playIcon">▶</span>
            <span id="pauseIcon" style="display: none;">⏸</span>
          </button>
          <div class="speed-controls">
            <label for="speedSelect">Speed:</label>
            <select id="speedSelect" class="speed-select">
              <option value="1">1×</option>
              <option value="10">10×</option>
              <option value="60" selected>60×</option>
              <option value="360">360×</option>
            </select>
          </div>
        </div>
      </div>

      <div class="slider-container">
        <label>
          <input type="checkbox" id="cloudToggle" checked /> Show clouds
        </label>
      </div>

      <div class="slider-container">
        <label>
          <input type="checkbox" id="markerToggle" checked /> Show city markers
        </label>
        <div class="city-search-container">
          <input
            type="text"
            id="citySearch"
            class="city-search-input"
            placeholder="Search cities..."
            autocomplete="off"
          />
          <button id="citySearchClear" class="city-search-clear" style="display: none;" title="Clear search">✕</button>
          <div id="citySearchResults" class="city-search-results"></div>
        </div>
      </div>

      <div class="slider-container">
        <label>
          <input type="checkbox" id="refLinesToggle" /> Show reference lines
        </label>
      </div>

      <div class="slider-container">
        <label>
          <input type="checkbox" id="atmosphereToggle" checked /> Show atmosphere
        </label>
      </div>
    </div>

    <div class="instructions">
      <h4>Controls</h4>
      <ul>
        <li>Drag to rotate Earth</li>
        <li>Scroll to zoom in/out</li>
        <li>Use slider to change time</li>
        <li>Space: Play/Pause</li>
        <li>← → Arrow keys: Step time</li>
      </ul>
    </div>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
