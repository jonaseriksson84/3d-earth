---
// 3D Earth Visualization - Main Page
import '../styles/global.css';
import TimeControls from '../components/controls/TimeControls.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="description" content="Interactive 3D Earth with day/night visualization, city markers, moon phases, and astronomical features" />
    <meta name="theme-color" content="#0a1628" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon.svg" />
    <title>Earth</title>
  </head>

  <body>
    <div id="loading-overlay" class="loading-overlay" role="alert" aria-live="polite" aria-label="Loading Earth visualization">
      <div class="loading-content">
        <div class="loading-spinner" aria-hidden="true"></div>
        <p class="loading-text">Loading Earth textures...</p>
        <div class="loading-progress-container" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" aria-label="Texture loading progress">
          <div id="loading-progress" class="loading-progress"></div>
        </div>
        <p id="loading-status" class="loading-status">0%</p>
      </div>
    </div>

    <div id="error-overlay" class="error-overlay" style="display: none;" role="alert" aria-live="assertive">
      <div class="error-content">
        <p class="error-icon" aria-hidden="true">⚠</p>
        <p id="error-message" class="error-message">Failed to load textures</p>
        <button id="retry-button" class="retry-button">Retry</button>
      </div>
    </div>

    <button id="menuToggle" class="menu-toggle" aria-label="Toggle controls menu" aria-expanded="true" aria-controls="controlsPanel">
      <span class="menu-toggle-icon" aria-hidden="true"></span>
    </button>

    <div id="controlsPanel" class="controls" role="region" aria-label="Visualization controls">
      <TimeControls />

      <div class="slider-container">
        <label>
          <input type="checkbox" id="cloudToggle" checked aria-label="Toggle cloud layer visibility" /> Show clouds
        </label>
        <div class="cloud-mode-controls">
          <label for="cloudModeSelect">Mode:</label>
          <select id="cloudModeSelect" class="cloud-mode-select" aria-label="Cloud animation mode">
            <option value="static">Static</option>
            <option value="animated" selected>Animated</option>
          </select>
        </div>
      </div>

      <div class="slider-container">
        <label>
          <input type="checkbox" id="markerToggle" checked aria-label="Toggle city markers visibility" /> Show city markers
        </label>
        <div class="city-search-container" role="search" aria-label="City search">
          <input
            type="text"
            id="citySearch"
            class="city-search-input"
            placeholder="Search cities..."
            autocomplete="off"
            aria-label="Search for a city"
            aria-autocomplete="list"
            aria-controls="citySearchResults"
          />
          <button id="citySearchClear" class="city-search-clear" style="display: none;" title="Clear search" aria-label="Clear city search">✕</button>
          <div id="citySearchResults" class="city-search-results" role="listbox" aria-label="City search results"></div>
        </div>
      </div>

      <div class="slider-container custom-markers-section">
        <div class="slider-container-title">
          <label>Custom markers</label>
          <span class="custom-marker-count" id="customMarkerCount"></span>
        </div>
        <button id="addMarkerBtn" class="add-marker-btn" aria-label="Place a custom marker on the globe">+ Add marker</button>
        <div id="customMarkersList" class="custom-markers-list" aria-label="Custom markers list"></div>
      </div>

      <div class="slider-container">
        <label>
          <input type="checkbox" id="refLinesToggle" aria-label="Toggle reference lines visibility" /> Show reference lines
        </label>
      </div>

      <div class="slider-container">
        <label>
          <input type="checkbox" id="terminatorToggle" aria-label="Toggle day/night terminator line visibility" /> Show terminator line
        </label>
      </div>

      <div class="slider-container">
        <label>
          <input type="checkbox" id="moonToggle" aria-label="Toggle Moon visibility" /> Show Moon
        </label>
      </div>

      <div class="slider-container">
        <label>
          <input type="checkbox" id="satelliteToggle" aria-label="Toggle satellite orbit visibility" /> Show satellite orbits
        </label>
      </div>

      <div class="slider-container">
        <label>
          <input type="checkbox" id="auroraToggle" aria-label="Toggle aurora borealis and australis visualization" /> Show auroras
        </label>
      </div>

      <div class="slider-container">
        <label>
          <input type="checkbox" id="eclipseToggle" aria-label="Toggle solar eclipse visualization" /> Show eclipses
        </label>
        <div id="eclipseNotification" class="eclipse-notification" style="display: none;" aria-live="polite"></div>
        <div id="eclipseButtons" class="eclipse-buttons" aria-label="Quick-jump to upcoming eclipses"></div>
      </div>

      <div class="slider-container">
        <label>
          <input type="checkbox" id="atmosphereToggle" checked aria-label="Toggle atmospheric glow effect" /> Show atmosphere
        </label>
      </div>

      <div class="slider-container">
        <label>
          <input type="checkbox" id="timezoneToggle" aria-label="Toggle timezone boundary lines" /> Show timezone boundaries
        </label>
      </div>

      <div class="slider-container">
        <label>
          <input type="checkbox" id="solarIntensityToggle" aria-label="Toggle sun intensity gradient and subsolar point indicator" /> Show sun intensity
        </label>
      </div>

      <div class="slider-container sun-times-container">
        <div class="slider-container-title">
          <label>Sunrise &amp; Sunset</label>
        </div>
        <div id="sunTimesDisplay" class="sun-times-display" aria-live="polite" aria-label="Sunrise and sunset times">
          <span class="sun-times-loading">Select a city or detect location...</span>
        </div>
      </div>
    </div>

    <div class="instructions" role="complementary" aria-label="Keyboard and mouse controls help">
      <h4>Controls</h4>
      <ul>
        <li>Drag to rotate Earth</li>
        <li>Scroll / pinch to zoom</li>
        <li>Tap a marker to fly to city</li>
        <li>Use slider to change time</li>
        <li>Space: Play/Pause</li>
        <li>← → Arrow keys: Step time</li>
      </ul>
      <div id="rendererInfo" class="renderer-info" aria-label="Rendering backend information"></div>
    </div>

    <script>
      import '../scripts/main';
      import '../scripts/register-sw';
    </script>
  </body>
</html>
