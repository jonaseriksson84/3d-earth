---
// 3D Earth Visualization - Main Page
import '../styles/global.css';
import TimeControls from '../components/controls/TimeControls.astro';
import VisualizationOptions from '../components/controls/VisualizationOptions.astro';
import Markers from '../components/controls/Markers.astro';
import EclipseControls from '../components/controls/EclipseControls.astro';
import LoadingOverlay from '../components/overlays/LoadingOverlay.astro';
import ErrorOverlay from '../components/overlays/ErrorOverlay.astro';
import SunTimesDisplay from '../components/panels/SunTimesDisplay.astro';
import InstructionsPanel from '../components/panels/InstructionsPanel.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="description" content="Interactive 3D Earth with day/night visualization, city markers, moon phases, and astronomical features" />
    <meta name="theme-color" content="#0a1628" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon.svg" />
    <title>Earth</title>
  </head>

  <body>
    <LoadingOverlay />
    <ErrorOverlay />

    <button id="menuToggle" class="menu-toggle" aria-label="Toggle controls menu" aria-expanded="true" aria-controls="controlsPanel">
      <span class="menu-toggle-icon" aria-hidden="true"></span>
    </button>

    <div id="controlsPanel" class="controls" role="region" aria-label="Visualization controls">
      <TimeControls />

      <VisualizationOptions />

      <Markers />

      <EclipseControls />

      <SunTimesDisplay />
    </div>

    <InstructionsPanel />

    <script>
      import '../scripts/main';
      import '../scripts/register-sw';
    </script>
  </body>
</html>
