---
/**
 * Panel.astro - Semi-transparent panel container
 *
 * @example
 * <Panel>Basic panel content</Panel>
 * <Panel variant="darker" class="my-panel">Darker panel content</Panel>
 * <Panel id="controlsPanel" variant="controls">Controls content</Panel>
 */

interface Props {
  /** Optional unique ID for the panel - required for JS event binding */
  id?: string;
  /** Panel variant style */
  variant?: 'default' | 'darker' | 'controls' | 'instructions';
  /** ARIA role for accessibility */
  role?: astroHTML.JSX.HTMLAttributes['role'];
  /** ARIA label for accessibility */
  ariaLabel?: string;
  /** Additional CSS classes */
  class?: string;
}

const { id, variant = 'default', role, ariaLabel, class: className } = Astro.props;

const baseClasses =
  'rounded-lg p-4 text-[color:var(--color-text-primary)] backdrop-blur-[8px] [-webkit-backdrop-filter:blur(8px)] motion-reduce:backdrop-blur-none motion-reduce:[-webkit-backdrop-filter:none]';

const variantClasses: Record<string, string> = {
  default: 'bg-[color:var(--color-panel)]',
  darker: 'bg-[color:var(--color-panel-darker)]',
  controls:
    'fixed top-4 left-4 max-w-[280px] max-h-[calc(100vh-2rem)] overflow-y-auto z-[100] flex flex-col gap-3 p-4 bg-[color:var(--color-panel)] [-webkit-overflow-scrolling:touch] max-[480px]:top-0 max-[480px]:left-0 max-[480px]:right-0 max-[480px]:bottom-auto max-[480px]:max-w-full max-[480px]:max-h-[50vh] max-[480px]:rounded-none max-[480px]:rounded-b-lg',
  instructions:
    'fixed bottom-4 right-4 max-w-[200px] py-3 px-4 text-xs z-[100] bg-[color:var(--color-panel)] pointer-coarse:hidden',
};
---

<div
  id={id}
  role={role}
  aria-label={ariaLabel}
  class:list={[baseClasses, variantClasses[variant], className]}
>
  <slot />
</div>
