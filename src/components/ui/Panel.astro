---
/**
 * Panel.astro - Semi-transparent panel container
 *
 * @example
 * <Panel>Basic panel content</Panel>
 * <Panel variant="darker" class="my-panel">Darker panel content</Panel>
 * <Panel id="controlsPanel" variant="controls">Controls content</Panel>
 */

interface Props {
  /** Optional unique ID for the panel - required for JS event binding */
  id?: string;
  /** Panel variant style */
  variant?: 'default' | 'darker' | 'controls' | 'instructions';
  /** ARIA role for accessibility */
  role?: string;
  /** ARIA label for accessibility */
  ariaLabel?: string;
  /** Additional CSS classes */
  class?: string;
}

const {
  id,
  variant = 'default',
  role,
  ariaLabel,
  class: className,
} = Astro.props;
---

<div
  id={id}
  role={role}
  aria-label={ariaLabel}
  class:list={["panel", `panel-${variant}`, className]}
>
  <slot />
</div>

<style>
  .panel {
    background: var(--color-panel, rgba(0, 0, 0, 0.7));
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 0.5rem;
    padding: 1rem;
    color: var(--color-text-primary, #fff);
  }

  /* Darker variant - more opaque background */
  .panel-darker {
    background: var(--color-panel-darker, rgba(0, 0, 0, 0.85));
  }

  /* Controls variant - sidebar controls panel styling */
  .panel-controls {
    position: fixed;
    top: 1rem;
    left: 1rem;
    max-width: 280px;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
    z-index: 100;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
    -webkit-overflow-scrolling: touch;
  }

  /* Instructions variant - helper text panel styling */
  .panel-instructions {
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    max-width: 200px;
    padding: 0.75rem 1rem;
    font-size: 0.75rem;
    z-index: 100;
  }

  .panel-instructions h4 {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-primary, #fff);
  }

  .panel-instructions ul {
    margin: 0;
    padding-left: 1.25rem;
    list-style-type: disc;
  }

  .panel-instructions li {
    margin-bottom: 0.25rem;
    color: var(--color-text-secondary, rgba(255, 255, 255, 0.85));
  }

  /* Mobile responsive adjustments */
  @media (max-width: 480px) {
    .panel-controls {
      top: 0;
      left: 0;
      right: 0;
      bottom: auto;
      max-width: 100%;
      max-height: 50vh;
      border-radius: 0 0 0.5rem 0.5rem;
    }
  }

  /* Hide instructions panel on touch devices */
  @media (pointer: coarse) {
    .panel-instructions {
      display: none;
    }
  }

  /* Reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .panel {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
