---
/**
 * SearchInput.astro - Search input with clear button and dropdown slot
 *
 * @example
 * <SearchInput
 *   id="citySearch"
 *   placeholder="Search cities..."
 *   resultsId="citySearchResults"
 *   clearButtonId="citySearchClear"
 *   ariaLabel="Search for a city"
 * >
 *   <div slot="results" id="citySearchResults" class="city-search-results" role="listbox"></div>
 * </SearchInput>
 */

interface Props {
  /** Unique ID for the input element - required for JS event binding */
  id: string;
  /** Placeholder text for the input */
  placeholder?: string;
  /** ID of the results dropdown element (for aria-controls) */
  resultsId?: string;
  /** ID for the clear button */
  clearButtonId?: string;
  /** Custom aria-label for accessibility */
  ariaLabel?: string;
  /** Additional CSS classes for the container */
  class?: string;
}

const {
  id,
  placeholder = 'Search...',
  resultsId,
  clearButtonId,
  ariaLabel,
  class: className,
} = Astro.props;
---

<div class:list={["relative w-full", className]} role="search" aria-label={ariaLabel || 'Search'}>
  <div class="relative flex items-center">
    <input
      type="text"
      id={id}
      placeholder={placeholder}
      autocomplete="off"
      aria-label={ariaLabel || placeholder}
      aria-autocomplete="list"
      aria-controls={resultsId}
      class="w-full py-2 pr-8 pl-3 font-inherit text-sm text-[color:var(--color-text-primary)] bg-[color:var(--color-input-bg)] border border-[color:var(--color-input-border)] rounded-md outline-none transition-[border-color,background-color] duration-150 ease-in-out placeholder:text-[color:var(--color-text-dimmer)] hover:border-white/30 focus:border-[color:var(--color-accent)] focus:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)] pointer-coarse:min-h-[44px] pointer-coarse:py-2.5 pointer-coarse:pr-10 pointer-coarse:pl-3.5 pointer-coarse:text-base motion-reduce:transition-none"
    />
    <button
      id={clearButtonId}
      type="button"
      class="absolute right-1.5 top-1/2 -translate-y-1/2 flex items-center justify-center size-6 p-0 text-base font-bold text-[color:var(--color-text-dimmer)] bg-transparent border-none rounded-full cursor-pointer transition-[color,background-color] duration-150 ease-in-out hover:text-[color:var(--color-text-primary)] hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[color:var(--color-accent)] pointer-coarse:size-8 pointer-coarse:right-2 hidden motion-reduce:transition-none"
      title="Clear search"
      aria-label="Clear search"
    >
      <span aria-hidden="true">&times;</span>
    </button>
  </div>
  <slot name="results" />
</div>
