---
/**
 * Toggle.astro - Reusable checkbox toggle with label
 *
 * @example
 * <Toggle id="cloudToggle" label="Show clouds" checked />
 * <Toggle id="moonToggle" label="Show Moon" ariaLabel="Toggle Moon visibility" />
 */

interface Props {
  /** Unique ID for the checkbox element - required for JS event binding */
  id: string;
  /** Display label text */
  label: string;
  /** Whether the checkbox is checked by default */
  checked?: boolean;
  /** Custom aria-label for accessibility (defaults to label text) */
  ariaLabel?: string;
  /** Additional CSS classes for the container */
  class?: string;
}

const { id, label, checked = false, ariaLabel, class: className } = Astro.props;
---

<label class:list={["flex items-center gap-2 cursor-pointer select-none pointer-coarse:min-h-[44px] pointer-coarse:py-2", className]}>
  <input
    type="checkbox"
    id={id}
    checked={checked}
    aria-label={ariaLabel || `Toggle ${label.toLowerCase()}`}
    class="size-4 cursor-pointer accent-[color:var(--color-accent)] pointer-coarse:size-5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)]"
  />
  <span class="text-sm text-[color:var(--color-text-primary)]">{label}</span>
</label>
