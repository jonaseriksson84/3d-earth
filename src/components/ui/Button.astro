---
/**
 * Button.astro - Reusable button with multiple variants
 *
 * @example
 * <Button id="playPauseBtn" variant="icon" ariaLabel="Play time animation">▶</Button>
 * <Button id="presetSpringEquinox" variant="preset" title="Spring Equinox">Spring Eq</Button>
 * <Button id="retryButton" variant="primary">Retry</Button>
 * <Button variant="secondary">Cancel</Button>
 */

interface Props {
  /** Optional unique ID for the button - required for JS event binding */
  id?: string;
  /** Button variant style */
  variant?: 'primary' | 'secondary' | 'preset' | 'icon';
  /** Optional title/tooltip text */
  title?: string;
  /** Custom aria-label for accessibility */
  ariaLabel?: string;
  /** Whether the button is disabled */
  disabled?: boolean;
  /** Button type attribute */
  type?: 'button' | 'submit' | 'reset';
  /** Additional CSS classes */
  class?: string;
}

const {
  id,
  variant = 'primary',
  title,
  ariaLabel,
  disabled = false,
  type = 'button',
  class: className,
} = Astro.props;

const baseClasses =
  'inline-flex items-center justify-center gap-1.5 font-inherit text-sm font-medium border-none rounded-md cursor-pointer transition-[background-color,border-color,transform] duration-150 ease-in-out disabled:opacity-50 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)] motion-reduce:transition-none pointer-coarse:min-h-[44px] pointer-coarse:min-w-[44px]';

const variantClasses: Record<string, string> = {
  primary:
    'px-5 py-2.5 bg-[color:var(--color-accent)] text-black hover:not-disabled:bg-[color:var(--color-accent-hover)] active:not-disabled:bg-[color:var(--color-accent-active)] active:not-disabled:scale-[0.98]',
  secondary:
    'px-4 py-2 bg-[color:var(--color-input-bg)] text-[color:var(--color-text-primary)] border border-[color:var(--color-input-border)] hover:not-disabled:bg-white/15 hover:not-disabled:border-white/30 active:not-disabled:bg-white/20',
  preset:
    'btn-preset flex-auto min-w-fit px-2.5 py-1.5 bg-[color:var(--color-input-bg)] text-[color:var(--color-text-secondary)] text-xs border border-transparent hover:not-disabled:bg-[rgba(77,166,255,0.2)] hover:not-disabled:text-[color:var(--color-text-primary)] active:not-disabled:bg-[rgba(77,166,255,0.3)] active:not-disabled:border-[color:var(--color-accent)] active:not-disabled:text-[color:var(--color-text-primary)] pointer-coarse:py-2 pointer-coarse:px-3 pointer-coarse:text-[0.8125rem]',
  icon: 'size-9 p-0 bg-[color:var(--color-accent)] text-black rounded-full text-sm hover:not-disabled:bg-[color:var(--color-accent-hover)] active:not-disabled:bg-[color:var(--color-accent-active)] active:not-disabled:scale-95 pointer-coarse:size-11',
};
---

<button
  id={id}
  type={type}
  title={title}
  aria-label={ariaLabel}
  disabled={disabled}
  class:list={[baseClasses, variantClasses[variant], className]}
>
  <slot />
</button>

<style>
  /* JS-added .active class for preset buttons - cannot be expressed as Tailwind utility */
  :global(.btn-preset.active) {
    background: rgba(77, 166, 255, 0.3);
    border-color: var(--color-accent, #4da6ff);
    color: var(--color-text-primary, #fff);
  }
</style>
