---
/**
 * Button.astro - Reusable button with multiple variants
 *
 * @example
 * <Button id="playPauseBtn" variant="icon" ariaLabel="Play time animation">▶</Button>
 * <Button id="presetSpringEquinox" variant="preset" title="Spring Equinox">Spring Eq</Button>
 * <Button id="retryButton" variant="primary">Retry</Button>
 * <Button variant="secondary">Cancel</Button>
 */

interface Props {
  /** Optional unique ID for the button - required for JS event binding */
  id?: string;
  /** Button variant style */
  variant?: 'primary' | 'secondary' | 'preset' | 'icon';
  /** Optional title/tooltip text */
  title?: string;
  /** Custom aria-label for accessibility */
  ariaLabel?: string;
  /** Whether the button is disabled */
  disabled?: boolean;
  /** Button type attribute */
  type?: 'button' | 'submit' | 'reset';
  /** Additional CSS classes */
  class?: string;
}

const {
  id,
  variant = 'primary',
  title,
  ariaLabel,
  disabled = false,
  type = 'button',
  class: className,
} = Astro.props;
---

<button
  id={id}
  type={type}
  title={title}
  aria-label={ariaLabel}
  disabled={disabled}
  class:list={["btn", `btn-${variant}`, className]}
>
  <slot />
</button>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    border: none;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
  }

  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-accent, #4da6ff);
    outline-offset: 2px;
  }

  /* Primary variant - main CTA button */
  .btn-primary {
    padding: 0.625rem 1.25rem;
    background: var(--color-accent, #4da6ff);
    color: #000;
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--color-accent-hover, #3d8fdb);
  }

  .btn-primary:active:not(:disabled) {
    background: var(--color-accent-active, #2d7cc4);
    transform: scale(0.98);
  }

  /* Secondary variant - subtle action button */
  .btn-secondary {
    padding: 0.5rem 1rem;
    background: var(--color-input-bg, rgba(255, 255, 255, 0.1));
    color: var(--color-text-primary, #fff);
    border: 1px solid var(--color-input-border, rgba(255, 255, 255, 0.2));
  }

  .btn-secondary:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .btn-secondary:active:not(:disabled) {
    background: rgba(255, 255, 255, 0.2);
  }

  /* Preset variant - compact buttons for preset selections */
  .btn-preset {
    padding: 0.375rem 0.625rem;
    background: var(--color-input-bg, rgba(255, 255, 255, 0.1));
    color: var(--color-text-secondary, rgba(255, 255, 255, 0.85));
    font-size: 0.75rem;
    border: 1px solid transparent;
  }

  .btn-preset:hover:not(:disabled) {
    background: rgba(77, 166, 255, 0.2);
    color: var(--color-text-primary, #fff);
  }

  .btn-preset:active:not(:disabled),
  .btn-preset.active {
    background: rgba(77, 166, 255, 0.3);
    border-color: var(--color-accent, #4da6ff);
    color: var(--color-text-primary, #fff);
  }

  /* Icon variant - circular icon button */
  .btn-icon {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    background: var(--color-accent, #4da6ff);
    color: #000;
    border-radius: 50%;
    font-size: 0.875rem;
  }

  .btn-icon:hover:not(:disabled) {
    background: var(--color-accent-hover, #3d8fdb);
  }

  .btn-icon:active:not(:disabled) {
    background: var(--color-accent-active, #2d7cc4);
    transform: scale(0.95);
  }

  /* Touch-friendly sizing for mobile */
  @media (pointer: coarse) {
    .btn {
      min-height: 44px;
      min-width: 44px;
    }

    .btn-preset {
      padding: 0.5rem 0.75rem;
      font-size: 0.8125rem;
    }

    .btn-icon {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  /* Reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }
  }
</style>
