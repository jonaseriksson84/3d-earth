---
/**
 * TimeControls.astro - Time control section component
 *
 * Groups date picker, season presets, time slider, and playback controls
 * into a cohesive time controls section.
 *
 * @example
 * <TimeControls />
 */

interface Props {
  /** Additional CSS classes for the container */
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["flex flex-col gap-4", className]}>
  <!-- Date Picker with Season Presets -->
  <div class="flex flex-col gap-2 p-3 bg-[color:var(--color-panel-darker)] rounded-lg pointer-coarse:p-4">
    <div class="flex justify-between items-center gap-2">
      <label for="datePicker" class="text-sm font-medium text-[color:var(--color-text-primary)]">Date</label>
      <input
        type="date"
        id="datePicker"
        class="date-picker py-1.5 px-2 bg-[color:var(--color-input-bg)] border border-[color:var(--color-input-border)] rounded text-[color:var(--color-text-primary)] text-[0.8125rem] font-inherit focus:outline-none focus:border-[color:var(--color-accent)]"
        aria-label="Select date for visualization"
      />
    </div>
    <div class="flex flex-wrap gap-1.5" role="group" aria-label="Astronomical date presets">
      <button
        class="preset-btn flex-auto min-w-fit py-1.5 px-2.5 bg-[color:var(--color-input-bg)] border border-transparent rounded text-[color:var(--color-text-secondary)] text-xs font-inherit cursor-pointer transition-[background-color,border-color] duration-150 ease-in-out hover:bg-[rgba(77,166,255,0.2)] hover:text-[color:var(--color-text-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)] pointer-coarse:min-h-[44px] pointer-coarse:py-2 pointer-coarse:px-3 pointer-coarse:text-[0.8125rem] motion-reduce:transition-none"
        id="presetSpringEquinox"
        title="Spring Equinox: Day and night are nearly equal length worldwide"
        aria-label="Set date to Spring Equinox"
      >Spring Eq</button>
      <button
        class="preset-btn flex-auto min-w-fit py-1.5 px-2.5 bg-[color:var(--color-input-bg)] border border-transparent rounded text-[color:var(--color-text-secondary)] text-xs font-inherit cursor-pointer transition-[background-color,border-color] duration-150 ease-in-out hover:bg-[rgba(77,166,255,0.2)] hover:text-[color:var(--color-text-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)] pointer-coarse:min-h-[44px] pointer-coarse:py-2 pointer-coarse:px-3 pointer-coarse:text-[0.8125rem] motion-reduce:transition-none"
        id="presetSummerSolstice"
        title="Summer Solstice: Longest day in the Northern Hemisphere"
        aria-label="Set date to Summer Solstice"
      >Summer Sol</button>
      <button
        class="preset-btn flex-auto min-w-fit py-1.5 px-2.5 bg-[color:var(--color-input-bg)] border border-transparent rounded text-[color:var(--color-text-secondary)] text-xs font-inherit cursor-pointer transition-[background-color,border-color] duration-150 ease-in-out hover:bg-[rgba(77,166,255,0.2)] hover:text-[color:var(--color-text-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)] pointer-coarse:min-h-[44px] pointer-coarse:py-2 pointer-coarse:px-3 pointer-coarse:text-[0.8125rem] motion-reduce:transition-none"
        id="presetAutumnEquinox"
        title="Autumn Equinox: Day and night are nearly equal length worldwide"
        aria-label="Set date to Autumn Equinox"
      >Autumn Eq</button>
      <button
        class="preset-btn flex-auto min-w-fit py-1.5 px-2.5 bg-[color:var(--color-input-bg)] border border-transparent rounded text-[color:var(--color-text-secondary)] text-xs font-inherit cursor-pointer transition-[background-color,border-color] duration-150 ease-in-out hover:bg-[rgba(77,166,255,0.2)] hover:text-[color:var(--color-text-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)] pointer-coarse:min-h-[44px] pointer-coarse:py-2 pointer-coarse:px-3 pointer-coarse:text-[0.8125rem] motion-reduce:transition-none"
        id="presetWinterSolstice"
        title="Winter Solstice: Shortest day in the Northern Hemisphere"
        aria-label="Set date to Winter Solstice"
      >Winter Sol</button>
    </div>
  </div>

  <!-- Time Slider with Playback Controls -->
  <div class="flex flex-col gap-2 p-3 bg-[color:var(--color-panel-darker)] rounded-lg pointer-coarse:p-4">
    <div class="flex justify-between items-center gap-2">
      <label for="timeSlider" class="text-sm font-medium text-[color:var(--color-text-primary)]">Time control</label>
      <span class="text-sm text-[color:var(--color-text-primary)] tabular-nums" aria-live="polite">
        <span id="currentTime">--:-- <span class="text-xs text-[color:var(--color-text-muted)]">(--:-- UTC)</span></span>
      </span>
    </div>
    <input
      type="range"
      id="timeSlider"
      class="time-slider w-full h-1.5 bg-[color:var(--color-input-bg)] rounded appearance-none cursor-pointer pointer-coarse:h-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)]"
      min="0"
      max="1440"
      value="720"
      step="15"
      aria-label="Time of day slider"
      aria-valuetext="12:00"
    />
    <div class="flex items-center gap-3 mt-1">
      <button
        id="playPauseBtn"
        class="flex items-center justify-center size-9 bg-[color:var(--color-accent)] border-none rounded-full text-black text-sm cursor-pointer transition-[background-color,transform] duration-150 ease-in-out hover:bg-[color:var(--color-accent-hover)] active:bg-[color:var(--color-accent-active)] active:scale-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)] pointer-coarse:size-11 motion-reduce:transition-none"
        title="Play/Pause (Space)"
        aria-label="Play time animation"
      >
        <span id="playIcon" aria-hidden="true">&#9654;</span>
        <span id="pauseIcon" class="hidden" aria-hidden="true">&#9208;</span>
      </button>
      <div class="flex items-center gap-1.5">
        <label for="speedSelect" class="text-xs text-[color:var(--color-text-muted)]">Speed:</label>
        <select
          id="speedSelect"
          class="py-1 px-2 bg-[color:var(--color-input-bg)] border border-[color:var(--color-input-border)] rounded text-[color:var(--color-text-primary)] text-xs font-inherit cursor-pointer focus:outline-none focus:border-[color:var(--color-accent)] pointer-coarse:min-h-[44px] pointer-coarse:py-2 pointer-coarse:px-3 pointer-coarse:text-sm"
          aria-label="Playback speed multiplier"
        >
          <option value="1">1&times;</option>
          <option value="10">10&times;</option>
          <option value="60" selected>60&times;</option>
          <option value="360">360&times;</option>
        </select>
      </div>
    </div>
  </div>
</div>

<style>
  /* Browser-specific pseudo-elements - cannot be expressed as Tailwind utilities */
  .date-picker::-webkit-calendar-picker-indicator {
    filter: invert(1);
    cursor: pointer;
  }

  .time-slider::-webkit-slider-thumb {
    width: 1rem;
    height: 1rem;
    background: var(--color-accent, #4da6ff);
    border: none;
    border-radius: 50%;
    appearance: none;
    cursor: pointer;
    transition: transform 0.1s ease;
  }

  .time-slider::-webkit-slider-thumb:hover {
    transform: scale(1.15);
  }

  .time-slider::-moz-range-thumb {
    width: 1rem;
    height: 1rem;
    background: var(--color-accent, #4da6ff);
    border: none;
    border-radius: 50%;
    cursor: pointer;
  }

  /* JS-added .active class for preset buttons */
  :global(.preset-btn.active) {
    background: rgba(77, 166, 255, 0.3);
    border-color: var(--color-accent, #4da6ff);
    color: var(--color-text-primary, #fff);
  }

  @media (pointer: coarse) {
    .time-slider::-webkit-slider-thumb {
      width: 1.5rem;
      height: 1.5rem;
    }

    .time-slider::-moz-range-thumb {
      width: 1.5rem;
      height: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .time-slider::-webkit-slider-thumb {
      transition: none;
    }
  }
</style>
