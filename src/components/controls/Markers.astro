---
/**
 * Markers.astro - Markers section component
 *
 * Groups city markers and custom markers into a cohesive section including:
 * - City markers toggle
 * - City search input with autocomplete
 * - Custom markers subsection (add button, marker list)
 *
 * @example
 * <Markers />
 */

interface Props {
  /** Additional CSS classes for the container */
  class?: string;
}

const { class: className } = Astro.props;

const toggleClasses =
  'flex items-center gap-2 cursor-pointer select-none pointer-coarse:min-h-[44px]';
const checkboxClasses =
  'size-4 cursor-pointer accent-[color:var(--color-accent)] pointer-coarse:size-5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)]';
const labelClasses = 'text-[0.8125rem] text-[color:var(--color-text-primary)]';
const optionGroupClasses =
  'flex flex-col gap-1.5 py-1.5 border-b border-white/5 pointer-coarse:py-2';
---

<div class:list={["flex flex-col gap-1 p-3 bg-[color:var(--color-panel-darker)] rounded-lg pointer-coarse:p-4", className]}>
  <h3 class="m-0 mb-2 p-0 text-sm font-medium tracking-wide text-[color:var(--color-text-primary)]">Markers</h3>

  <!-- City markers toggle -->
  <div class:list={[optionGroupClasses, "!pt-0"]}>
    <label class={toggleClasses}>
      <input type="checkbox" id="markerToggle" checked aria-label="Toggle city markers visibility" class={checkboxClasses} />
      <span class={labelClasses}>Show city markers</span>
    </label>
  </div>

  <!-- City search -->
  <div class:list={[optionGroupClasses, "pt-1"]}>
    <div class="relative w-full" role="search" aria-label="City search">
      <input
        type="text"
        id="citySearch"
        class="w-full py-2 pr-8 pl-3 font-inherit text-[0.8125rem] text-[color:var(--color-text-primary)] bg-[color:var(--color-input-bg)] border border-[color:var(--color-input-border)] rounded outline-none transition-[border-color] duration-150 ease-in-out placeholder:text-[color:var(--color-text-dimmer)] hover:border-white/30 focus:border-[color:var(--color-accent)] focus:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)] pointer-coarse:min-h-[44px] pointer-coarse:py-2.5 pointer-coarse:pr-10 pointer-coarse:pl-3.5 pointer-coarse:text-sm motion-reduce:transition-none"
        placeholder="Search cities..."
        autocomplete="off"
        aria-label="Search for a city"
        aria-autocomplete="list"
        aria-controls="citySearchResults"
      />
      <button
        id="citySearchClear"
        class="absolute right-1.5 top-1/2 -translate-y-1/2 flex items-center justify-center size-6 p-0 text-base font-bold text-[color:var(--color-text-dimmer)] bg-transparent border-none rounded-full cursor-pointer transition-[color,background-color] duration-150 ease-in-out hover:text-[color:var(--color-text-primary)] hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[color:var(--color-accent)] pointer-coarse:size-8 pointer-coarse:right-2 hidden motion-reduce:transition-none"
        title="Clear search"
        aria-label="Clear city search"
      >
        <span aria-hidden="true">&times;</span>
      </button>
      <div
        id="citySearchResults"
        class="city-search-results"
        role="listbox"
        aria-label="City search results"
      ></div>
    </div>
  </div>

  <!-- Custom markers -->
  <div class="flex flex-col gap-2 py-1.5 pointer-coarse:py-2">
    <div class="flex items-center justify-between gap-2">
      <span class="text-[0.8125rem] text-[color:var(--color-text-primary)]">Custom markers</span>
      <span class="text-xs text-[color:var(--color-text-muted)]" id="customMarkerCount"></span>
    </div>
    <button
      id="addMarkerBtn"
      class="add-marker-btn flex items-center justify-center w-full py-2 px-3 font-inherit text-[0.8125rem] font-medium text-[color:var(--color-text-primary)] bg-[color:var(--color-input-bg)] border border-dashed border-[color:var(--color-input-border)] rounded cursor-pointer transition-[background-color,border-color] duration-150 ease-in-out hover:bg-[rgba(77,166,255,0.15)] hover:border-[color:var(--color-accent)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)] pointer-coarse:min-h-[44px] pointer-coarse:text-sm motion-reduce:transition-none"
      aria-label="Place a custom marker on the globe"
    >
      + Add marker
    </button>
    <div
      id="customMarkersList"
      class="flex flex-col gap-1 max-h-[150px] overflow-y-auto"
      aria-label="Custom markers list"
    ></div>
  </div>
</div>
