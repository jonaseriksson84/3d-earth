---
/**
 * VisualizationOptions.astro - Visualization toggles section component
 *
 * Groups all visualization toggle options into a cohesive section including:
 * - Clouds toggle with animation mode selector
 * - Atmosphere toggle
 * - Reference lines toggle
 * - Terminator line toggle
 * - Moon toggle
 * - Aurora toggle
 * - Sun intensity toggle
 * - Satellite orbits toggle
 * - Timezone boundaries toggle
 *
 * @example
 * <VisualizationOptions />
 */

interface Props {
  /** Additional CSS classes for the container */
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["visualization-options", className]}>
  <h3 class="section-header">Visualization</h3>

  <!-- Clouds with mode selector -->
  <div class="option-group">
    <label class="toggle">
      <input
        type="checkbox"
        id="cloudToggle"
        checked
        aria-label="Toggle cloud layer visibility"
        class="toggle-checkbox"
      />
      <span class="toggle-label">Show clouds</span>
    </label>
    <div class="cloud-mode-controls">
      <label for="cloudModeSelect" class="mode-label">Mode:</label>
      <select id="cloudModeSelect" class="mode-select" aria-label="Cloud animation mode">
        <option value="static">Static</option>
        <option value="animated" selected>Animated</option>
      </select>
    </div>
  </div>

  <!-- Atmosphere -->
  <div class="option-group">
    <label class="toggle">
      <input
        type="checkbox"
        id="atmosphereToggle"
        checked
        aria-label="Toggle atmospheric glow effect"
        class="toggle-checkbox"
      />
      <span class="toggle-label">Show atmosphere</span>
    </label>
  </div>

  <!-- Reference lines -->
  <div class="option-group">
    <label class="toggle">
      <input
        type="checkbox"
        id="refLinesToggle"
        aria-label="Toggle reference lines visibility"
        class="toggle-checkbox"
      />
      <span class="toggle-label">Show reference lines</span>
    </label>
  </div>

  <!-- Terminator line -->
  <div class="option-group">
    <label class="toggle">
      <input
        type="checkbox"
        id="terminatorToggle"
        aria-label="Toggle day/night terminator line visibility"
        class="toggle-checkbox"
      />
      <span class="toggle-label">Show terminator line</span>
    </label>
  </div>

  <!-- Moon -->
  <div class="option-group">
    <label class="toggle">
      <input
        type="checkbox"
        id="moonToggle"
        aria-label="Toggle Moon visibility"
        class="toggle-checkbox"
      />
      <span class="toggle-label">Show Moon</span>
    </label>
  </div>

  <!-- Aurora -->
  <div class="option-group">
    <label class="toggle">
      <input
        type="checkbox"
        id="auroraToggle"
        aria-label="Toggle aurora borealis and australis visualization"
        class="toggle-checkbox"
      />
      <span class="toggle-label">Show auroras</span>
    </label>
  </div>

  <!-- Sun intensity -->
  <div class="option-group">
    <label class="toggle">
      <input
        type="checkbox"
        id="solarIntensityToggle"
        aria-label="Toggle sun intensity gradient and subsolar point indicator"
        class="toggle-checkbox"
      />
      <span class="toggle-label">Show sun intensity</span>
    </label>
  </div>

  <!-- Satellite orbits -->
  <div class="option-group">
    <label class="toggle">
      <input
        type="checkbox"
        id="satelliteToggle"
        aria-label="Toggle satellite orbit visibility"
        class="toggle-checkbox"
      />
      <span class="toggle-label">Show satellite orbits</span>
    </label>
  </div>

  <!-- Timezone boundaries -->
  <div class="option-group">
    <label class="toggle">
      <input
        type="checkbox"
        id="timezoneToggle"
        aria-label="Toggle timezone boundary lines"
        class="toggle-checkbox"
      />
      <span class="toggle-label">Show timezone boundaries</span>
    </label>
  </div>
</div>

<style>
  .visualization-options {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem;
    background: var(--color-panel-darker, rgba(0, 0, 0, 0.2));
    border-radius: 0.5rem;
  }

  .section-header {
    margin: 0 0 0.5rem 0;
    padding: 0;
    color: var(--color-text-primary, #fff);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.025em;
  }

  .option-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.375rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .option-group:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .option-group:first-of-type {
    padding-top: 0;
  }

  /* Toggle styling */
  .toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    user-select: none;
  }

  .toggle-checkbox {
    width: 1rem;
    height: 1rem;
    accent-color: var(--color-accent, #4da6ff);
    cursor: pointer;
  }

  .toggle-label {
    color: var(--color-text-primary, #fff);
    font-size: 0.8125rem;
  }

  /* Cloud mode controls */
  .cloud-mode-controls {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-left: 1.5rem;
  }

  .mode-label {
    color: var(--color-text-muted, rgba(255, 255, 255, 0.5));
    font-size: 0.75rem;
  }

  .mode-select {
    padding: 0.25rem 0.5rem;
    background: var(--color-input-bg, rgba(255, 255, 255, 0.1));
    border: 1px solid var(--color-input-border, rgba(255, 255, 255, 0.2));
    border-radius: 0.25rem;
    color: var(--color-text-primary, #fff);
    font-size: 0.75rem;
    font-family: inherit;
    cursor: pointer;
  }

  .mode-select:focus {
    outline: none;
    border-color: var(--color-accent, #4da6ff);
  }

  /* Touch-friendly sizing for mobile */
  @media (pointer: coarse) {
    .visualization-options {
      padding: 1rem;
    }

    .option-group {
      padding: 0.5rem 0;
    }

    .toggle {
      min-height: 44px;
    }

    .toggle-checkbox {
      width: 1.25rem;
      height: 1.25rem;
    }

    .toggle-label {
      font-size: 0.875rem;
    }

    .mode-select {
      min-height: 44px;
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
    }
  }

  /* Focus styles for accessibility */
  .toggle-checkbox:focus-visible {
    outline: 2px solid var(--color-accent, #4da6ff);
    outline-offset: 2px;
  }

  .mode-select:focus-visible {
    outline: 2px solid var(--color-accent, #4da6ff);
    outline-offset: 2px;
  }

  /* Reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .toggle-checkbox,
    .mode-select {
      transition: none;
    }
  }
</style>
