---
/**
 * VisualizationOptions.astro - Visualization toggles section component
 *
 * Groups all visualization toggle options into a cohesive section including:
 * - Clouds toggle with animation mode selector
 * - Atmosphere toggle
 * - Reference lines toggle
 * - Terminator line toggle
 * - Moon toggle
 * - Aurora toggle
 * - Sun intensity toggle
 * - Satellite orbits toggle
 * - Timezone boundaries toggle
 *
 * @example
 * <VisualizationOptions />
 */

interface Props {
  /** Additional CSS classes for the container */
  class?: string;
}

const { class: className } = Astro.props;

const toggleClasses =
  'flex items-center gap-2 cursor-pointer select-none pointer-coarse:min-h-[44px]';
const checkboxClasses =
  'size-4 cursor-pointer accent-[color:var(--color-accent)] pointer-coarse:size-5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)]';
const labelClasses = 'text-[0.8125rem] text-[color:var(--color-text-primary)]';
const optionGroupClasses = 'py-1 border-b border-white/5 pointer-coarse:py-1.5';
---

<div class:list={["flex flex-col p-2.5 bg-[color:var(--color-panel-darker)] rounded-lg pointer-coarse:p-3.5", className]}>
  <!-- Clouds with mode selector (inline) -->
  <div class:list={[optionGroupClasses, "!pt-0"]}>
    <div class="flex items-center justify-between gap-2">
      <label class={toggleClasses}>
        <input type="checkbox" id="cloudToggle" checked aria-label="Toggle cloud layer visibility" class={checkboxClasses} />
        <span class={labelClasses}>Clouds</span>
      </label>
      <select
        id="cloudModeSelect"
        class="py-0.5 px-1.5 bg-[color:var(--color-input-bg)] border border-[color:var(--color-input-border)] rounded text-[color:var(--color-text-primary)] text-xs font-inherit cursor-pointer focus:outline-none focus:border-[color:var(--color-accent)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)] pointer-coarse:min-h-[44px] pointer-coarse:py-2 pointer-coarse:px-3 pointer-coarse:text-sm motion-reduce:transition-none"
        aria-label="Cloud animation mode"
      >
        <option value="static">Static</option>
        <option value="animated" selected>Animated</option>
      </select>
    </div>
  </div>

  <!-- Atmosphere -->
  <div class={optionGroupClasses}>
    <label class={toggleClasses}>
      <input type="checkbox" id="atmosphereToggle" checked aria-label="Toggle atmospheric glow effect" class={checkboxClasses} />
      <span class={labelClasses}>Atmosphere</span>
    </label>
  </div>

  <!-- Reference lines -->
  <div class={optionGroupClasses}>
    <label class={toggleClasses}>
      <input type="checkbox" id="refLinesToggle" aria-label="Toggle reference lines visibility" class={checkboxClasses} />
      <span class={labelClasses}>Reference lines</span>
    </label>
  </div>

  <!-- Terminator line -->
  <div class={optionGroupClasses}>
    <label class={toggleClasses}>
      <input type="checkbox" id="terminatorToggle" aria-label="Toggle day/night terminator line visibility" class={checkboxClasses} />
      <span class={labelClasses}>Terminator line</span>
    </label>
  </div>

  <!-- Moon -->
  <div class={optionGroupClasses}>
    <label class={toggleClasses}>
      <input type="checkbox" id="moonToggle" aria-label="Toggle Moon visibility" class={checkboxClasses} />
      <span class={labelClasses}>Moon</span>
    </label>
  </div>

  <!-- Aurora -->
  <div class={optionGroupClasses}>
    <label class={toggleClasses}>
      <input type="checkbox" id="auroraToggle" aria-label="Toggle aurora borealis and australis visualization" class={checkboxClasses} />
      <span class={labelClasses}>Auroras</span>
    </label>
  </div>

  <!-- Sun intensity -->
  <div class={optionGroupClasses}>
    <label class={toggleClasses}>
      <input type="checkbox" id="solarIntensityToggle" aria-label="Toggle sun intensity gradient and subsolar point indicator" class={checkboxClasses} />
      <span class={labelClasses}>Sun intensity</span>
    </label>
  </div>

  <!-- Satellite orbits -->
  <div class={optionGroupClasses}>
    <label class={toggleClasses}>
      <input type="checkbox" id="satelliteToggle" aria-label="Toggle satellite orbit visibility" class={checkboxClasses} />
      <span class={labelClasses}>Satellite orbits</span>
    </label>
  </div>

  <!-- Timezone boundaries -->
  <div class="py-1 pointer-coarse:py-1.5">
    <label class={toggleClasses}>
      <input type="checkbox" id="timezoneToggle" aria-label="Toggle timezone boundary lines" class={checkboxClasses} />
      <span class={labelClasses}>Timezone boundaries</span>
    </label>
  </div>
</div>
