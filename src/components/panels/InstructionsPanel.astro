---
/**
 * InstructionsPanel Component
 *
 * Displays keyboard and mouse control instructions.
 * Shows renderer backend information.
 * Positioned at bottom-right of the screen.
 *
 * Element IDs (preserved for JS compatibility):
 * - rendererInfo: Renderer backend information display
 */
---

<div
  class="absolute bottom-5 right-5 bg-[color:var(--color-panel)] p-[0.9375rem] rounded-lg text-[color:var(--color-text-primary)] text-xs max-w-[12.5rem] z-50 pointer-coarse:hidden max-[768px]:bottom-2.5 max-[768px]:right-2.5 max-[768px]:p-2.5 max-[768px]:max-w-[10rem] max-[768px]:text-[0.6875rem] motion-reduce:transition-none"
  role="complementary"
  aria-label="Keyboard and mouse controls help"
>
  <h4 class="m-0 mb-2 text-sm font-semibold text-[color:var(--color-text-primary)] max-[768px]:text-xs">Controls</h4>
  <ul class="m-0 pl-[0.9375rem] text-[color:var(--color-text-secondary)] list-disc">
    <li class="mb-1 leading-relaxed">Drag to rotate Earth</li>
    <li class="mb-1 leading-relaxed">Scroll / pinch to zoom</li>
    <li class="mb-1 leading-relaxed">Tap a marker to fly to city</li>
    <li class="mb-1 leading-relaxed">Use slider to change time</li>
    <li class="mb-1 leading-relaxed">Space: Play/Pause</li>
    <li class="mb-1 leading-relaxed">&larr; &rarr; Arrow keys: Step time</li>
  </ul>
  <div
    id="rendererInfo"
    class="mt-2 pt-1.5 border-t border-white/15 text-[0.625rem] text-[color:var(--color-text-dim)] opacity-70"
    aria-label="Rendering backend information"
  ></div>
</div>
