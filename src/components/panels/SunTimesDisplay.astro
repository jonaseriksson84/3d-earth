---
/**
 * SunTimesDisplay Component
 *
 * Displays sunrise and sunset times for selected location.
 * Shows user location or selected city sun times.
 * Updates dynamically when date or location changes.
 *
 * Element IDs (preserved for JS compatibility):
 * - sunTimesDisplay: Main display container
 */
---

<div class="p-2.5 bg-black/30 rounded-md border-t border-white/10">
  <div
    id="sunTimesDisplay"
    class="text-[0.8125rem] text-[color:var(--color-text-secondary)] leading-normal"
    aria-live="polite"
    aria-label="Sunrise and sunset times"
  >
    <span class="sun-times-loading">Select a city or detect location...</span>
  </div>
</div>

<style>
  /* Styles for JS-dynamically-created child elements - cannot be Tailwind utilities */
  #sunTimesDisplay :global(.sun-times-loading) {
    color: var(--color-text-dim, #999999);
    font-style: italic;
  }

  #sunTimesDisplay :global(.sun-times-location) {
    color: var(--color-text-primary, #ffffff);
    font-weight: bold;
    margin-bottom: 0.125rem;
  }

  #sunTimesDisplay :global(.sun-times-row) {
    display: flex;
    justify-content: space-between;
  }

  #sunTimesDisplay :global(.sun-rise) {
    color: var(--color-sunrise, #ffcc44);
  }

  #sunTimesDisplay :global(.sun-set) {
    color: var(--color-sunset, #ff8844);
  }

  #sunTimesDisplay :global(.sun-polar) {
    color: var(--color-text-muted, #aaaaaa);
    font-style: italic;
  }
</style>
