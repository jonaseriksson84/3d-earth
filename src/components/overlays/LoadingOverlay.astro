---
/**
 * LoadingOverlay Component
 *
 * Displays a full-screen loading overlay with spinner, progress bar, and status text.
 * Used during texture and asset loading.
 *
 * Element IDs (for JS compatibility):
 * - loading-overlay: Main overlay container
 * - loading-progress: Progress bar fill element
 * - loading-status: Status text showing percentage
 */
---

<div
  id="loading-overlay"
  class="fixed inset-0 z-[1000] flex items-center justify-center bg-black transition-opacity duration-500 ease-out"
  role="alert"
  aria-live="polite"
  aria-label="Loading Earth visualization"
>
  <div class="text-center text-white">
    <!-- Spinner -->
    <div
      class="mx-auto mb-5 h-[60px] w-[60px] animate-spin rounded-full border-4 border-white/20 border-t-[color:var(--color-accent)]"
      aria-hidden="true"
    ></div>

    <!-- Loading text -->
    <p class="m-0 mb-4 text-lg text-[color:var(--color-text-secondary)]">
      Loading Earth textures...
    </p>

    <!-- Progress bar container -->
    <div
      class="mx-auto h-1.5 w-[200px] overflow-hidden rounded-[3px] bg-white/20"
      role="progressbar"
      aria-valuenow="0"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-label="Texture loading progress"
    >
      <!-- Progress bar fill -->
      <div
        id="loading-progress"
        class="h-full w-0 rounded-[3px] bg-gradient-to-r from-[color:var(--color-accent)] to-[#00d4ff] transition-[width] duration-300 ease-out"
      ></div>
    </div>

    <!-- Status percentage -->
    <p
      id="loading-status"
      class="m-0 mt-2.5 text-sm text-[color:var(--color-text-dim)]"
    >
      0%
    </p>
  </div>
</div>

<style>
  /* Fade out state - added via JS when loading complete */
  #loading-overlay:global(.fade-out) {
    opacity: 0;
    pointer-events: none;
  }

  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    #loading-overlay > div > div:first-child {
      animation: none;
      opacity: 0.7;
    }

    #loading-overlay:global(.fade-out) {
      transition: none;
    }

    #loading-progress {
      transition: none;
    }
  }
</style>
